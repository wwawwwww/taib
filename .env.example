# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.1

# Telegram
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token
TELEGRAM_CHAT_ID=@your_channel_username

# Product mode
ACTIVE_MODE=tracking

# Posting
POST_LANGUAGE=ru
POST_MAX_CHARS=3500
POST_TEMPERATURE=0.8

# Spontaneous posting
SPONTANEOUS_ENABLED=true
SPONTANEOUS_CHECK_INTERVAL_MINUTES=60
SPONTANEOUS_MIN_PAUSE_MINUTES=360

# Channel autopilot
AUTOPILOT_ENABLED=false
AUTOPILOT_POSTS_PER_DAY=2
AUTOPILOT_MIN_PAUSE_MINUTES=240

# Group chat mode
GROUP_CHAT_ENABLED=false
# Group id usually looks like -1001234567890. You can also use @public_group_username.
GROUP_CHAT_ID=
# Use at least one target selector. Numeric id is best, username is easiest.
GROUP_TARGET_USER_ID=
GROUP_TARGET_USERNAME=
GROUP_TARGET_NAME=
# 0.12 means about 12% of eligible messages.
GROUP_REPLY_PROBABILITY=0.12
GROUP_MIN_PAUSE_SECONDS=90
GROUP_CONTEXT_MESSAGES=16

# Daily activity scan
# Comma-separated folders. Keep it focused for better posts and lower token cost.
ACTIVITY_SCAN_ROOTS=~/Documents,~/Desktop,~/Downloads
ACTIVITY_EXCLUDE_DIRS=node_modules,.git,.venv,venv,__pycache__,Library
ACTIVITY_MAX_FILES=80
ACTIVITY_MAX_CHARS_PER_FILE=6000
ACTIVITY_MAX_TOTAL_CHARS=60000
